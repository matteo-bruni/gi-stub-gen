class {{enum.name}}({{enum.super_full_type_str(module_name)}}):
    {% if enum.docstring or debug %}
    """
    {{ enum.debug | if_true(debug, "{}\n") | indent(4, blank=True) -}}
    {{enum.docstring | if_exists | trim | indent(4, blank=True) -}}
    """
    {% endif %}

    {% for f in enum.fields %}
    {{f.name}} = {{f.value_repr}} {{ f.line_comment | if_exists("# ") }}
    {% if f.docstring %}
    """
    {{f.docstring | trim | indent(4, blank=True) }}
    """
    {% endif %}
    {% endfor %}
    {% if enum.methods %}
    # gi Methods
    {% for method in enum.methods %}
    {{ method.render_compact() | indent(4, first=False) }}
    {% endfor %}
    {% endif %}
    

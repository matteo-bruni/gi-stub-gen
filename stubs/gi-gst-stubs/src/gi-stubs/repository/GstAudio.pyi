    @builtins.property
    def _gst_reserved(self) -> list[object] | None: ...
    meta: Gst.Meta | None = ...  # type: ignore
    """
    parent GstMeta
    """
    num_bytes_per_channel: int = ...
    """
    the number of valid bytes per channel in the buffer
    """
    num_channels: int = ...
    """
    number of channels in the DSD data
    """
    offsets: int = ...
    """
    the offsets (in bytes) where each channel plane starts in the buffer
    """
    @builtins.property
    def priv_offsets_arr(self) -> list[int] | None: ...

    # gi Methods
    @staticmethod
    def get_info() -> Gst.MetaInfo: ...


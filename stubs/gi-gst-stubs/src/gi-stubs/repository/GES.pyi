        in_point: int | None = None,
        max_duration: int | None = None,
        name: str | None = None,
        parent: TimelineElement | None = None,
        priority: int | None = None,
        serialize: bool | None = None,
        start: int | None = None,
        timeline: Timeline | None = None,
        track_type: TrackType | None = TrackType(1),
    ) -> None:
        """
        Initialize Effect object with properties.
        """

    # python methods (overrides?)
    @classmethod
    def new(
        cls,
        bin_description: str,
    ) -> Effect | None:
        """
        [is-override: Note this method is an override in Python of the original gi implementation.]

        new(bin_description:str) -> GES.Effect or None

        Creates a new GES.Effect from the description of the bin. It should be
